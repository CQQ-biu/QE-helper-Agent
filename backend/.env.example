# PostgreSQL + pgvector
DATABASE_URL=postgresql+psycopg2://qe_helper:qe_helper@localhost:5432/qe_helper

# Redis / Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# 文件与日志
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
LOG_DIR=./logs
LOG_LEVEL=INFO

# API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# RAG：可使用 OpenAI 或支持 embeddings、chat completions、tool calling 的兼容服务
RAG_API_KEY=your-api-key
RAG_BASE_URL=https://api.openai.com/v1
RAG_CHAT_MODEL=gpt-4.1-mini
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536
RAG_KNOWLEDGE_BASE_DIR=./knowledge_base
# 关键词到来源文件的业务映射清单，支持 xlsx/csv/json；文件不存在时退回普通RAG来源
RAG_SOURCE_MAPPING_FILE=./source_mapping.xlsx
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.35
# 递归语义切分的目标大小与重叠大小（估算 token 数）
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_EMBEDDING_BATCH_SIZE=64
RAG_TEMPERATURE=0.1
RAG_REQUEST_TIMEOUT=60
# 单个问题允许 Agent 决策/检索的最大循环次数
RAG_AGENT_MAX_ITERATIONS=3
# 是否启用多 Agent 编排（主 Agent 路由 + 子 Agent 权限隔离）；false 时回退到单 Agent 循环
RAG_MULTI_AGENT_ENABLED=true
